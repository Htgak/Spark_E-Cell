# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit the real .env file.

# Admin panel password (required)
ADMIN_PASSWORD=your-strong-password-here

# Firebase Admin SDK (Cloud Firestore Database ONLY — NO Firebase Storage needed)
FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_PATH=./server/firebase-service-account.json

# Set to true on first launch to copy server/data/*.json into Firestore
FIREBASE_MIGRATE_LOCAL_DATA=false

# ── Free Image Storage Alternatives ───────────────────────────
# Option 1: Local Disk (DEFAULT: 100% Free, Zero accounts needed)
# Simply leave Cloudinary and ImgBB blank. Uploads are saved to server/uploads/

# Option 2: Cloudinary (Free 25GB Cloud CDN - https://cloudinary.com)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# or use an unsigned preset:
# CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# Option 3: ImgBB (Free Unlimited Image Hosting - https://api.imgbb.com)
# IMGBB_API_KEY=your_imgbb_api_key

# HTTP port the server listens on (optional, default: 3000)
# PORT=3000

